+import org.junit.Assert.*
+import org.junit.Test
+class CasePopupPolicyTest {
+    @Test fun sustainedOpenDoesNotRepeat() {
+        val p = CasePopupPolicy()
+        assertTrue(p.canShow("AirPods Pro 3", true, -40, true, true, 0, "A")); p.onShown(0)
+        for (t in 1000L..120000L step 1000L) assertFalse(p.canShow("AirPods Pro 3", true, -40, true, true, t, "A"))
+        assertFalse(p.canShow("AirPods Pro 3", false, -40, true, true, 121000, "A"))
+        assertTrue(p.canShow("AirPods Pro 3", true, -40, true, true, 122000, "A"))
+    }
+    @Test fun requiresOptInBondAndProximity() {
+        assertFalse(CasePopupPolicy().canShow("AirPods Pro 3", true, -40, false, true, 0))
+        assertFalse(CasePopupPolicy().canShow("AirPods Pro 3", true, -40, true, false, 0))
+        assertFalse(CasePopupPolicy().canShow("AirPods Pro 3", true, -85, true, true, 0))
+        assertFalse(CasePopupPolicy().canShow("AirPods Pro", true, -40, true, true, 0))
+    }
+    @Test fun rotatingAddressDoesNotBypassGlobalCooldown() {
+        val p = CasePopupPolicy()
+        assertTrue(p.canShow("AirPods Pro 3", true, -40, true, true, 0, "A")); p.onShown(0)
+        assertFalse(p.canShow("AirPods Pro 3", true, -40, true, true, 1000, "B"))
+    }
+}
