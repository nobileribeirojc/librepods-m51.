+/* LibrePods M51 — AGPL-3.0-or-later. Audio profile is independent of AACP. */
+package me.kavishdevar.librepods.composables
+
+import android.annotation.SuppressLint
+import android.bluetooth.*
+import android.content.*
+import android.os.Build
+import androidx.compose.material3.Text
+import androidx.compose.runtime.*
+import androidx.compose.ui.platform.LocalContext
+
+@SuppressLint("MissingPermission")
+@Composable
+fun M51ConnectionStatus() {
+    val context = LocalContext.current
+    var audio by remember { mutableStateOf("Consultando conexão de áudio…") }
+    DisposableEffect(context) {
+        val adapter = context.getSystemService(BluetoothManager::class.java)?.adapter
+        val proxies = mutableMapOf<Int, BluetoothProfile>()
+        var disposed = false
+        fun refresh() {
+            try {
+                val saved = context.getSharedPreferences("settings", Context.MODE_PRIVATE).getString("mac_address", null)
+                val connected = proxies.values.flatMap { it.connectedDevices }.any {
+                    if (saved != null) it.address == saved else it.name?.contains("AirPods", true) == true
+                }
+                audio = if (connected) "Áudio Bluetooth conectado" else "Áudio dos AirPods não detectado nos perfis Bluetooth"
+            } catch (_: SecurityException) { audio = "Autorize Dispositivos próximos para verificar o áudio" }
+        }
+        val listener = object : BluetoothProfile.ServiceListener {
+            override fun onServiceConnected(profile: Int, proxy: BluetoothProfile) {
+                if (disposed) { adapter?.closeProfileProxy(profile, proxy); return }
+                proxies[profile] = proxy
+                refresh()
+            }
+            override fun onServiceDisconnected(profile: Int) { proxies.remove(profile); if (!disposed) refresh() }
+        }
+        val receiver = object : BroadcastReceiver() {
+            override fun onReceive(context: Context?, intent: Intent?) { refresh() }
+        }
+        val filter = IntentFilter().apply {
+            addAction(BluetoothA2dp.ACTION_CONNECTION_STATE_CHANGED)
+            addAction(BluetoothHeadset.ACTION_CONNECTION_STATE_CHANGED)
+            addAction(BluetoothAdapter.ACTION_STATE_CHANGED)
+        }
+        if (Build.VERSION.SDK_INT >= 33) context.registerReceiver(receiver, filter, Context.RECEIVER_EXPORTED)
+        else context.registerReceiver(receiver, filter)
+        try {
+            if (adapter == null || !adapter.isEnabled) audio = "Bluetooth desligado ou indisponível"
+            else {
+                adapter.getProfileProxy(context, listener, BluetoothProfile.A2DP)
+                adapter.getProfileProxy(context, listener, BluetoothProfile.HEADSET)
+            }
+        } catch (_: SecurityException) { audio = "Autorize Dispositivos próximos para verificar o áudio" }
+        onDispose {
+            disposed = true
+            context.unregisterReceiver(receiver)
+            proxies.forEach { (profile, proxy) -> adapter?.closeProfileProxy(profile, proxy) }
+            proxies.clear()
+        }
+    }
+    Text(audio)
+}
