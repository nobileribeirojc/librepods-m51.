+package me.kavishdevar.librepods.utils
+import org.junit.Assert.*
+import org.junit.Test
+
+class PublicProximityTest {
+    // Synthetic protocol fixtures, NOT captured M51 traffic.
+    private fun frame(status: Int = 0x64, pods: Int = 0x99, caseFlags: Int = 0x01, lid: Int = 0) =
+        ByteArray(27).apply {
+            this[0] = 7; this[1] = 25; this[2] = 1; this[3] = 0x27; this[4] = 0x20
+            this[5] = status.toByte(); this[6] = pods.toByte(); this[7] = caseFlags.toByte(); this[8] = lid.toByte()
+        }
+    @Test fun reported9010Scenario() {
+        val r = PublicProximity.decode(frame())!!
+        assertEquals(90, r.left); assertEquals(90, r.right); assertEquals(10, r.case)
+        assertEquals(0x2720, r.modelId)
+    }
+    @Test fun unequalBatteriesLeftPrimary() {
+        val r = PublicProximity.decode(frame(pods = 0x38, caseFlags = 0x21))!!
+        assertEquals(80, r.left); assertEquals(30, r.right)
+        assertFalse(r.leftCharging); assertTrue(r.rightCharging)
+    }
+    @Test fun unequalBatteriesRightPrimary() {
+        val r = PublicProximity.decode(frame(status = 0x44, pods = 0x38, caseFlags = 0x21))!!
+        assertEquals(30, r.left); assertEquals(80, r.right)
+        assertTrue(r.leftCharging); assertFalse(r.rightCharging)
+    }
+    @Test fun unknownIsNotZero() {
+        val r = PublicProximity.decode(frame(pods = 0xff, caseFlags = 0xff))!!
+        assertNull(r.left); assertNull(r.right); assertNull(r.case)
+    }
+    @Test fun realZeroAndFullAreValid() {
+        val r = PublicProximity.decode(frame(pods = 0xa0, caseFlags = 0x0a))!!
+        assertEquals(0, r.left); assertEquals(100, r.right); assertEquals(100, r.case)
+    }
+    @Test fun reservedPercentagesAreUnknown() { for (n in 11..15) assertNull(PublicProximity.percent(n)) }
+    @Test fun truncatedFramesRejected() {
+        for (length in 0..26) { assertNull(PublicProximity.frame(frame().copyOf(length))); assertNull(PublicProximity.decode(frame().copyOf(length))) }
+    }
+    @Test fun unsupportedPrefixRejected() {
+        val f = frame().apply { this[2] = 7 }
+        assertNull(PublicProximity.frame(f)); assertNull(PublicProximity.decode(f))
+    }
+    @Test fun continuityMessageMayFollowAnotherTlv() {
+        assertArrayEquals(frame(), PublicProximity.frame(byteArrayOf(0x10, 2, 0, 0) + frame()))
+    }
+    @Test fun malformedTlvIsNotResynchronizedInsidePayload() {
+        assertNull(PublicProximity.frame(byteArrayOf(0x10, 100) + frame()))
+    }
+    @Test fun caseLidOnlyTrustedWithInCaseContext() {
+        assertTrue(PublicProximity.decode(frame())!!.lidOpen)
+        assertFalse(PublicProximity.decode(frame(lid = 8))!!.lidOpen)
+        assertFalse(PublicProximity.decode(frame(status = 0x20))!!.lidOpen)
+        assertFalse(PublicProximity.decode(frame(status = 0x10))!!.lidOpen)
+    }
+    @Test fun earOrientationMatchesPrimaryAndCase() {
+        assertTrue(PublicProximity.decode(frame(status = 0x22))!!.leftInEar)
+        assertFalse(PublicProximity.decode(frame(status = 0x22))!!.rightInEar)
+        assertTrue(PublicProximity.decode(frame(status = 0x08))!!.leftInEar)
+        assertTrue(PublicProximity.decode(frame(status = 0x68))!!.leftInEar)
+    }
+    @Test fun caseCacheExpiresAndUnknownDoesNotExtend() {
+        val c = PublicCaseCache()
+        assertEquals(10, c.read("A", 10, 0))
+        assertEquals(10, c.read("A", null, 29_999))
+        assertNull(c.read("A", null, 30_000))
+    }
+    @Test fun caseCacheNeverCrossesAddresses() {
+        val c = PublicCaseCache(); c.read("A", 10, 0)
+        assertNull(c.read("B", null, 1))
+        assertEquals(0, c.read("B", 0, 2))
+    }
+}
