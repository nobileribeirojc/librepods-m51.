+/* LibrePods M51 — AGPL-3.0-or-later.
+ * Public format cross-checked against CAPod DualApplePods / ProximityPairing.
+ * Independent decoder; never interprets encrypted bytes as public percentages.
+ */
+package me.kavishdevar.librepods.utils
+
+internal object PublicProximity {
+    data class Reading(
+        val modelId: Int, val left: Int?, val right: Int?, val case: Int?,
+        val leftCharging: Boolean, val rightCharging: Boolean, val caseCharging: Boolean,
+        val leftInEar: Boolean, val rightInEar: Boolean, val lidOpen: Boolean
+    )
+
+    /** Apple manufacturer bytes, AFTER company ID. Continuity is a TLV stream. */
+    fun frame(bytes: ByteArray): ByteArray? {
+        var offset = 0
+        while (offset + 2 <= bytes.size) {
+            val type = bytes[offset].toInt() and 255
+            val length = bytes[offset + 1].toInt() and 255
+            val end = offset + 2 + length
+            if (end > bytes.size) return null
+            if (type == 7 && length == 25 && bytes[offset + 2].toInt() == 1)
+                return bytes.copyOfRange(offset, end)
+            offset = end
+        }
+        return null
+    }
+
+    // Reserved values 11..14 are not a trustworthy 100%; 15 is unavailable.
+    fun percent(nibble: Int): Int? = if (nibble in 0..10) nibble * 10 else null
+
+    fun decode(frame: ByteArray): Reading? {
+        if (frame.size != 27 || frame[0].toInt() != 7 || frame[1].toInt() != 25 || frame[2].toInt() != 1) return null
+        fun byte(i: Int) = frame[i].toInt() and 255
+        val status = byte(5)
+        val flipped = status and 0x20 == 0
+        val inCase = status and 0x40 != 0
+        val earFlip = flipped xor inCase
+        val pods = byte(6)
+        val flags = byte(7) ushr 4
+        val reliableLid = inCase || status and 0x04 != 0
+        return Reading(
+            (byte(3) shl 8) or byte(4),
+            percent(if (flipped) pods ushr 4 else pods and 15),
+            percent(if (flipped) pods and 15 else pods ushr 4),
+            percent(byte(7) and 15),
+            flags and (if (flipped) 2 else 1) != 0,
+            flags and (if (flipped) 1 else 2) != 0,
+            flags and 4 != 0,
+            status and (if (earFlip) 8 else 2) != 0,
+            status and (if (earFlip) 2 else 8) != 0,
+            reliableLid && byte(8) and 8 == 0
+        )
+    }
+}
+
+/** Short same-address cache. Unknown packets never extend the last valid reading. */
+internal class PublicCaseCache(private val ttlMs: Long = 30_000L) {
+    private val readings = linkedMapOf<String, Pair<Int, Long>>()
+    fun read(address: String, level: Int?, now: Long): Int? {
+        readings.entries.removeAll { now - it.value.second >= ttlMs || now < it.value.second }
+        if (level != null) readings[address] = level to now
+        while (readings.size > 30) readings.remove(readings.keys.first())
+        return level ?: readings[address]?.first
+    }
+}
