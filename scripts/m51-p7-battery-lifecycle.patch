+package me.kavishdevar.librepods.utils
+
+import org.junit.Assert.*
+import org.junit.Test
+
+/** Synthetic radio events. These are not captures or a physical M51 test. */
+class M51BatteryPipelineTest {
+    private fun frame(pods: Int = 0x38, case: Int = 1, status: Int = 0x64) = ByteArray(27).apply {
+        this[0] = 7; this[1] = 25; this[2] = 1; this[3] = 0x27; this[4] = 0x20
+        this[5] = status.toByte(); this[6] = pods.toByte(); this[7] = case.toByte()
+    }
+    private fun reading(pods: Int = 0x38, case: Int = 1, status: Int = 0x64) = PublicProximity.decode(frame(pods, case, status))!!
+    @Test fun publicAdvertReachesAutomaticThreeComponentSnapshotWithoutIrk() {
+        val history = M51BatteryHistory()
+        val policy = M51AutoBatteryPolicy()
+        val decoded = PublicProximity.decode(PublicProximity.frame(frame())!!)!!
+        assertEquals(0x2720, decoded.modelId)
+        assertEquals(M51AutoBatteryPolicy.Decision.CHOSEN_SOURCE, policy.observe("A", -50, true, 1000))
+        val snapshot = history.observe("A", decoded, 1000, 1000)!!
+        assertEquals(80, snapshot.left?.percent); assertEquals(30, snapshot.right?.percent); assertEquals(10, snapshot.case?.percent)
+    }
+    @Test fun missingLeftDoesNotEraseRecentReadingOrRenewItsTimestamp() {
+        val h = M51BatteryHistory()
+        h.observe("A", reading(), 0, 0)
+        val s = h.observe("A", reading(pods = 0x4f, case = 15), 14000, 14000)!!
+        assertEquals(0L, s.left?.observedMs); assertEquals(14000L, s.right?.observedMs)
+        assertNull(s.fresh(15000).left); assertEquals(40, s.fresh(15000).right?.percent)
+        assertEquals(10, s.fresh(29999).case?.percent); assertNull(s.fresh(30000).case)
+    }
+    @Test fun noPacketsStillExpiresEachComponent() {
+        val s = M51BatteryHistory().observe("A", reading(), 1000, 1000)!!
+        assertNull(s.fresh(16000).left); assertNull(s.fresh(16000).right)
+        assertEquals(10, s.fresh(16000).case?.percent); assertNull(s.fresh(31000).case)
+    }
+    @Test fun changingAdvertiserNeverBorrowsCaseBattery() {
+        val h = M51BatteryHistory()
+        h.observe("A", reading(), 0, 0)
+        val s = h.observe("B", reading(case = 15), 100, 100)!!
+        assertEquals(80, s.left?.percent); assertNull(s.case)
+    }
+    @Test fun staleBatchesCannotReviveBattery() {
+        val h = M51BatteryHistory()
+        assertNull(h.observe("A", reading(), 100, 15100))
+        assertNull(h.observe("A", reading(), 200, 199))
+        assertNull(h.observe("A", reading(), -1, 100))
+    }
+    @Test fun outOfOrderPacketsCannotRewindValues() {
+        val h = M51BatteryHistory()
+        h.observe("A", reading(), 200, 200)
+        assertNull(h.observe("A", reading(pods = 0x00), 100, 300))
+        assertEquals(80, h.observe("A", reading(pods = 0xff), 400, 400)!!.left?.percent)
+    }
+    @Test fun realZeroSurvivesCacheAndUnknownDoesNotBecomeZero() {
+        val h = M51BatteryHistory()
+        val s = h.observe("A", reading(pods = 0xf0, case = 0), 0, 0)!!
+        assertEquals(0, s.left?.percent); assertNull(s.right); assertEquals(0, s.case?.percent)
+    }
+    @Test fun swappedPrimaryKeepsAnatomicalLeftAndRight() {
+        val h = M51BatteryHistory()
+        h.observe("A", reading(), 0, 0)
+        val s = h.observe("A", reading(pods = 0x83, status = 0x44), 1, 1)!!
+        assertEquals(80, s.left?.percent); assertEquals(30, s.right?.percent)
+    }
+    @Test fun oldCaseCannotBeRenewedByBudsUpdates() {
+        val h = M51BatteryHistory()
+        h.observe("A", reading(), 0, 0)
+        for (time in 1000L..29000L step 1000) h.observe("A", reading(case = 15), time, time)
+        assertNull(h.observe("A", reading(case = 15), 30000, 30000)!!.case)
+    }
+    @Test fun backwardsClockClearsHistory() {
+        val h = M51BatteryHistory()
+        h.observe("A", reading(), 9999, 9999)
+        assertNull(h.observe("A", reading(case = 15), 1, 1)!!.case)
+    }
+    @Test fun allNibbleCombinationsRespectOrientationAndUnknown() {
+        for (primary in listOf(0x64, 0x44)) for (a in 0..15) for (b in 0..15) {
+            val r = reading((a shl 4) or b, status = primary)
+            assertEquals(PublicProximity.percent(if (primary == 0x64) b else a), r.left)
+            assertEquals(PublicProximity.percent(if (primary == 0x64) a else b), r.right)
+        }
+    }
+}
