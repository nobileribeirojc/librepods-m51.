+/* LibrePods M51, AGPL-3.0-or-later. Independent public BLE history; no identity inference. */
+package me.kavishdevar.librepods.utils
+
+internal object M51AdvertisementTime {
+    fun isFresh(observedMs: Long, nowMs: Long): Boolean =
+        observedMs >= 0 && nowMs >= observedMs && nowMs - observedMs < 15_000L
+}
+
+internal class M51BatteryHistory {
+    data class Value(val percent: Int, val observedMs: Long)
+    data class Snapshot(val left: Value?, val right: Value?, val case: Value?) {
+        fun fresh(now: Long) = Snapshot(live(left, now, 15_000), live(right, now, 15_000), live(case, now, 30_000))
+        companion object {
+            private fun live(v: Value?, now: Long, ttl: Long) = v?.takeIf { now >= it.observedMs && now - it.observedMs < ttl }
+        }
+    }
+    private data class Entry(val at: Long, val snapshot: Snapshot)
+    private val entries = linkedMapOf<String, Entry>()
+
+    fun observe(address: String, r: PublicProximity.Reading, at: Long, now: Long): Snapshot? {
+        if (!M51AdvertisementTime.isFresh(at, now)) return null
+        entries.entries.removeAll { now < it.value.at || now - it.value.at >= 30_000L }
+        val old = entries[address]
+        if (old != null && at < old.at) return null
+        val previous = old?.snapshot?.fresh(now)
+        fun value(n: Int?, previous: Value?) = n?.takeIf { it in 0..100 }?.let { Value(it, at) } ?: previous
+        val result = Snapshot(value(r.left, previous?.left), value(r.right, previous?.right), value(r.case, previous?.case)).fresh(now)
+        entries[address] = Entry(at, result)
+        while (entries.size > 30) entries.remove(entries.keys.first())
+        return result
+    }
+}
